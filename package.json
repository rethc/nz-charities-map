{
  "name": "nz-charities-map",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/seo/build-pages.mts",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:etl": "uvx --with httpx pytest scripts/tests -q",
    "test:functions": "node --test tests/geocode-function.test.mts",
    "test:pages": "node --test tests/seo-pages.test.mts",
    "seo:areas": "node scripts/seo/refresh-areas.mts",
    "test": "npm run test:functions && npm run test:pages && npm run test:etl"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.11",
    "@fluentui/react-icons": "^2.0.344",
    "@supabase/supabase-js": "^2.118.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.5"
  }
}
