# ── Browser (bundled into the site — public values only) ───────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API Keys: the *publishable* key (sb_publishable_…)
# or the legacy anon key. Never put the service_role / secret key here.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# rpc (default, always fresh) | snapshot (CDN copy the sync job publishes nightly)
VITE_DATA_SOURCE=rpc
# Optional: any MapLibre style URL. Default: OpenFreeMap Positron (free, no key).
# VITE_BASEMAP_STYLE=https://tiles.openfreemap.org/styles/positron
# Optional: free LINZ Basemaps key → adds an aerial imagery toggle to /admin/triage.
# VITE_LINZ_BASEMAPS_KEY=

# ── Netlify Functions (set in Netlify → Site configuration → Environment variables,
#    scope "Functions"; netlify.toml env vars do NOT reach functions) ────────────
# LINZ_API_KEY=            # LINZ Data Service key, used by /api/geocode
# GEOCODER_CONTACT=you@example.org

# ── GitHub Actions secrets for scripts/sync_charities.py ──────────────────────
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=      # service_role JWT or sb_secret_… key — server-side only
# LINZ_API_KEY=
